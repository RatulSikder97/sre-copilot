# Copy to .env (never commit it). All settings use the SRE_COPILOT_ prefix.
# ANTHROPIC_API_KEY=            # required for live mode only
SRE_COPILOT_MODEL=claude-sonnet-5-5
SRE_COPILOT_EFFORT=medium
SRE_COPILOT_ALLOWED_NAMESPACES=demo
SRE_COPILOT_PROMETHEUS_URL=http://127.0.0.1:39090
SRE_COPILOT_LOKI_URL=http://127.0.0.1:39100
SRE_COPILOT_KUBECONFIG_READ=.demo/reader.kubeconfig
SRE_COPILOT_KUBECONFIG_WRITE=.demo/executor.kubeconfig
SRE_COPILOT_MAX_STEPS=16
SRE_COPILOT_MAX_TOOL_CALLS=40
SRE_COPILOT_MAX_TOTAL_TOKENS=400000
SRE_COPILOT_MAX_WALL_SECONDS=300
SRE_COPILOT_APPROVAL_TTL_SECONDS=900
# SRE_COPILOT_APPROVAL_SIGNING_SECRET=   # enables POST /proposals/{id}/decision
# SRE_COPILOT_ALERTMANAGER_TOKEN=        # bearer token required on the webhook
# SRE_COPILOT_NOTIFY_WEBHOOK_URL=        # Slack-compatible incoming webhook for proposals
